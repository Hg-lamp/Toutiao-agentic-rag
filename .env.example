# ========== API Keys（必填） ==========
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# ========== 数据库（默认指向本地） ==========
DATABASE_URL="mysql+aiomysql://root:root@localhost:3306/news_app?charset=utf8mb4"

# ========== LangGraph Checkpoint（PostgreSQL，用于会话持久化） ==========
CHECKPOINTER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/langgraph_db"

# ========== Redis ==========
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_VECTOR_URL="redis://localhost:6380"

# ========== RAG 子图 ==========
# 单请求内检索任务并发、单次检索超时（秒）
RAG_RETRIEVAL_CONCURRENCY=8
RAG_RETRIEVAL_TIMEOUT_SECONDS=25
# 父块向左右扩展的 chunk 数
RAG_PARENT_WINDOW=1
RAG_PARENT_EXPANSION_CONCURRENCY=8
# 多样性上限
RAG_MAX_PER_DOCUMENT=2
RAG_MAX_PER_SOURCE=3
# 上下文 token 预算及各项预留
RAG_TOTAL_TOKEN_BUDGET=8000
RAG_SYSTEM_TOKEN_RESERVE=1200
RAG_HISTORY_TOKEN_RESERVE=1200
RAG_OUTPUT_TOKEN_RESERVE=1000
RAG_SAFETY_TOKEN_MARGIN=500
RAG_MIN_CONTEXT_TOKENS=500
# RRF 回退重排参数
RAG_RRF_K=60
RAG_RERANK_WEIGHT=0.65
RAG_RETRIEVAL_WEIGHT=0.20
RAG_METADATA_WEIGHT=0.15

# ========== Ollama ==========
OLLAMA_BASE_URL="http://localhost:11434"
VISION_MODEL="qwen3-vl:4b-instruct-q4_K_M"
VISION_TIMEOUT="180"
VISION_MAX_CONCURRENCY="1"
VISION_MAX_IMAGE_SIDE="1024"
VISION_NUM_CTX="4096"
VISION_NUM_PREDICT="768"
VISION_KEEP_ALIVE="30m"

# ========== SearXNG 配置 ==========
SEARXNG_HOST="http://localhost:8080"
SEARXNG_SECRET_KEY="your_random_secret_key_here"

# ========== 实时新闻（详见 docs/NEWS_REALTIME.md） ==========
# 总开关，设 false 则完全关闭自动采集，回到改造前的行为
NEWS_REALTIME_ENABLED=true
# 启动时是否立刻抓一次
NEWS_REFRESH_ON_STARTUP=true
# 增量刷新间隔（分钟）
NEWS_REFRESH_INTERVAL_MINUTES=30
# 每天几点做一次全量刷新（本地时区，0-23）
NEWS_DAILY_REFRESH_HOUR=7
# 只收录最近 N 小时的新闻，避免旧闻入库
NEWS_MAX_AGE_HOURS=72
# 采集数据保留天数，超期自动清理
NEWS_RETENTION_DAYS=30
# 每个来源单次最多取多少条
NEWS_MAX_ITEMS_PER_SOURCE=30
# 是否再去抓原文页补全正文（关掉可以加快首轮抓取）
NEWS_ENRICH_ENABLED=true
# 每轮最多补全多少篇正文
NEWS_ENRICH_MAX_PER_RUN=30
# 单请求超时（秒）
NEWS_FETCH_TIMEOUT=12
# 抓取并发数
NEWS_FETCH_CONCURRENCY=6

# 手动触发 POST /api/news/refresh 的令牌，留空表示不校验（本地开发方便）
NEWS_REFRESH_TOKEN=""
# 临时停用某些来源（用 news_sources.py 里的 key，逗号分隔）
NEWS_DISABLED_SOURCES=""
# 打开默认关闭的来源，例如 "toutiao-hot"（今日头条热榜，只有标题没有正文）
NEWS_ENABLED_SOURCES=""
# 用 SearXNG 按频道搜索来补薄弱频道，例如 "军事,娱乐"；留空表示不用
NEWS_SEARXNG_CHANNELS=""
# 需要走代理才能访问新闻源时填写，例如 "http://127.0.0.1:7890"
NEWS_HTTP_PROXY=""

# ========== 日志 ==========
# 本地默认写入项目 logs/，自动轮转；Docker 默认只输出到容器日志
LOG_TO_FILE=true
LOG_DIR="logs"
LOG_LEVEL="INFO"
LOG_ROTATION="20 MB"
LOG_RETENTION="14 days"
LOG_COMPRESSION="zip"
# 排查 SQL 时临时改为 true，正常开发保持 false
DB_ECHO=false

# ========== Agent Tool Gateway / Sandbox ==========
TOOL_MAX_OUTPUT_BYTES=65536
TOOL_MAX_PARALLEL_CALLS=8
TOOL_DEFAULT_TIMEOUT_SECONDS=30
TOOL_MCP_HANDSHAKE_TIMEOUT_SECONDS=5
TOOL_MCP_MAX_MESSAGE_BYTES=1048576
SANDBOX_RUNTIME="docker"
# 本地先使用构建出的沙箱镜像；生产环境应替换为带 sha256 digest 的镜像。
SANDBOX_IMAGE="toutiao-agentic-rag-sandbox:dev"
SANDBOX_TTL_SECONDS=60
SANDBOX_CREATE_TIMEOUT_SECONDS=10
SANDBOX_DESTROY_GRACE_SECONDS=5
